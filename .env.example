# Bind loopback by default. Use a TLS reverse proxy with authentication before public exposure.
LISTEN_ADDR=127.0.0.1:8080
REDIS_URL=redis://127.0.0.1:6379/0
MODELSCOPE_ENDPOINT=https://www.modelscope.cn
MODELSCOPE_TOKEN=
MODELSCOPE_REPO_ID=your-owner/your-repo
MODELSCOPE_REPO_TYPE=datasets
# Dataset deletion ignores Revision upstream: datasets require master. Models may use a branch.
MODELSCOPE_REVISION=master
FILECABINET_NAMESPACE=00
# proxy: backend authenticates trusted LFS uploads; browser never receives the token.
# direct: experimental browser/native uploads; requires signed storage URL or existing blob.
# Browser needs upstream CORS (or a test extension); extension does NOT solve auth.
# Direct CSP allows HTTPS storage hosts below; proxy CSP stays same-origin only.
# Current ModelScope LFS URLs require auth, so new direct uploads return 422; use proxy.
UPLOAD_MODE=proxy
# proxy: backend streams bytes and enforces expiry/short-code on every request.
# direct: backend only authorizes, then redirects the browser to the upstream signed CDN
# URL. Bytes skip this host, but the returned URL is a bearer credential that outlives
# revocation (expiry, short code, cleanup) until its own auth_key expires (~30 min).
# Falls back to proxy streaming when upstream answers with a body (inline/non-LFS files).
DOWNLOAD_MODE=proxy
# DANGEROUS: direct only. Exposes the upstream upload href (never the token) to the browser for CORS experiments.
# Keep false in normal deployments and disable immediately after testing.
UNSAFE_DIRECT_EXPOSE_URL=false
MAX_UPLOAD_BYTES=10737418240
TRANSFER_TIMEOUT=30m
# Only URLs returned by authenticated upstream may be used, HTTPS/public IP only.
# This allowlist NEVER authorizes sending credentials. LFS auth requires the exact
# lfs.modelscope.cn origin + configured repo + expected hash/size path.
# Adjust only for a verified storage domain; never use broad suffixes like .com.
STORAGE_HOST_SUFFIXES=.modelscope.cn,.aliyuncs.com,.amazonaws.com
# Exactly ONE active backend per storage identity. Redis must retain its AOF and use noeviction.
# Durable owner has no TTL: crash/uncertain mutation requires manual reconciliation (README).
# No auto-steal and no unsafe token-to-browser mode. Redis data loss breaks protection.
